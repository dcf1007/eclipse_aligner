+def solar_component_search_guidance(gray, light_mask, color_image, settings):
+    """Build detached-component search ROIs for light and horizon discovery.
+
+    The component and both rounded ROIs are guidance only.  Final ellipse growth,
+    polarity, containment, and horizon side tests continue to use the untouched
+    full-size threshold/grayscale images.
+    """
+    center = None
+    if color_image is not None:
+        center = adaptive_solar_hint(color_image).get("center")
+    if center is None:
+        high = gray >= np.percentile(gray, 99.8)
+        ys, xs = np.nonzero(high)
+        if len(xs):
+            center = (float(xs.mean()), float(ys.mean()))
+        else:
+            center = (0.5 * gray.shape[1], 0.5 * gray.shape[0])
+
+    component = component_for_hint(light_mask, center)
+    if component is None or component["touches_border"]:
+        return None
+
+    expected_radius = max(1.0, 0.5 * (settings.min_radius + settings.max_radius))
+    result = dict(component)
+    result["center"] = center
+    result["light_roi"] = dilated_component_mask(
+        component["mask"],
+        LIGHT_COMPONENT_GUIDANCE_RADIUS * expected_radius,
+    )
+    result["horizon_roi"] = dilated_component_mask(
+        component["mask"],
+        HORIZON_COMPONENT_GUIDANCE_RADIUS * expected_radius,
+    )
+    result["light_roi_fraction"] = (
+        float(np.count_nonzero(result["light_roi"])) / max(light_mask.size, 1)
+    )
+    result["horizon_roi_fraction"] = (
+        float(np.count_nonzero(result["horizon_roi"])) / max(light_mask.size, 1)
+    )
+    return result
+
